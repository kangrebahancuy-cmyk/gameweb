# Copy to .env.local. Only PUBLIC values belong here (these are bundled into the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# WebSocket endpoint of the Cloudflare Worker. Local dev: ws://localhost:8787/ws
VITE_WS_URL=ws://localhost:8787/ws
# Local development only: skip Supabase and play as a throw-away guest. Must be false/absent in production.
VITE_DEV_AUTH=true
